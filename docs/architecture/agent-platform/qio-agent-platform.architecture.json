      ]
    },
    {
      "dot": "emerald",
      "title": "三种执行策略",
      "items": [
        "fixed：按既定 FlowConfig 顺序执行；auto：分析、执行、监督、总结",
        "flow：MCP 工具分析、任务规划、步骤解析、顺序执行并记录失败统计"
      ]
    },
    {
      "dot": "amber",
      "title": "RAG 数据链",
